{
  "name": "Profile",
  "type": "object",
  "properties": {
    "owner_label": {
      "type": "string",
      "description": "呼ばれたい名前（空でもよい）"
    },
    "ultimate_goal": {
      "type": "string",
      "description": "最終的にたどり着きたい目的"
    },
    "current_focus": {
      "type": "string",
      "description": "いま集中したいこと"
    },
    "tone": {
      "type": "string",
      "description": "AIに望む語り口"
    },
    "daily_minutes": {
      "type": "number",
      "default": 30
    }
  },
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
