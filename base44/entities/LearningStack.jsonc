{
  "name": "LearningStack",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "分野の名前（例：能動的推論）"
    },
    "description": {
      "type": "string",
      "description": "この分野を学ぶ理由・位置づけ"
    },
    "focus_concepts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "この分野で押さえたい概念"
    },
    "accent": {
      "type": "string",
      "description": "表示トーン（clay / sage / sand / sky / dusk）"
    },
    "sort_order": {
      "type": "number"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
