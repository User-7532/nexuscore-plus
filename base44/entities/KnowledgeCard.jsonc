{
  "name": "KnowledgeCard",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "概念の名前"
    },
    "summary": {
      "type": "string",
      "description": "自分の言葉に近づけた要約"
    },
    "key_concepts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "カード同士を自動でつなぐ共通概念"
    },
    "open_question": {
      "type": "string",
      "description": "次に考えたい小さな問い"
    },
    "domain": {
      "type": "string",
      "description": "分野名"
    },
    "stack_id": {
      "type": "string"
    },
    "source_conversation_id": {
      "type": "string",
      "description": "出典となった対話"
    },
    "related_card_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "understanding": {
      "type": "number",
      "default": 0,
      "description": "0=これから / 1=わからないところがある / 2=だいたいわかる / 3=人に説明できる"
    },
    "visit_count": {
      "type": "number",
      "default": 0
    },
    "last_visited_at": {
      "type": "string",
      "format": "date-time"
    },
    "field": {
      "type": "string",
      "description": "大分野のID（active-inference / math-physics / computation / neuroscience / social）"
    },
    "subfield": {
      "type": "string",
      "description": "下位分野のID（src/lib/taxonomy.js）"
    },
    "verifiable": {
      "type": "string",
      "description": "解釈が中心の分野で、確かめられる事実だけをまとめた部分"
    },
    "interpretation": {
      "type": "string",
      "description": "解釈が中心の分野で、解釈・仮説としてまとめた部分"
    },
    "source": {
      "type": "string",
      "enum": [
        "dialogue",
        "field",
        "assistant",
        "import"
      ],
      "description": "dialogue=学びの対話から / field=分野を選んでAIが作成 / assistant=全画面共通のAIチャットから / import=ほかのAIとの会話を取り込んで作成"
    }
  },
  "required": [
    "title",
    "summary"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}