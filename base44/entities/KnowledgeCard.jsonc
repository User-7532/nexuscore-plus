{
  "name": "KnowledgeCard",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u6982\u5ff5\u306e\u540d\u524d"
    },
    "summary": {
      "type": "string",
      "description": "\u81ea\u5206\u306e\u8a00\u8449\u306b\u8fd1\u3065\u3051\u305f\u8981\u7d04"
    },
    "key_concepts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u30ab\u30fc\u30c9\u540c\u58eb\u3092\u81ea\u52d5\u3067\u3064\u306a\u3050\u5171\u901a\u6982\u5ff5"
    },
    "open_question": {
      "type": "string",
      "description": "\u6b21\u306b\u8003\u3048\u305f\u3044\u5c0f\u3055\u306a\u554f\u3044"
    },
    "domain": {
      "type": "string",
      "description": "\u5206\u91ce\u540d"
    },
    "stack_id": {
      "type": "string"
    },
    "source_conversation_id": {
      "type": "string",
      "description": "\u51fa\u5178\u3068\u306a\u3063\u305f\u5bfe\u8a71"
    },
    "related_card_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "understanding": {
      "type": "number",
      "default": 0,
      "description": "0=\u3053\u308c\u304b\u3089 / 1=\u308f\u304b\u3089\u306a\u3044\u3068\u3053\u308d\u304c\u3042\u308b / 2=\u3060\u3044\u305f\u3044\u308f\u304b\u308b / 3=\u4eba\u306b\u8aac\u660e\u3067\u304d\u308b"
    },
    "visit_count": {
      "type": "number",
      "default": 0
    },
    "last_visited_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "summary"
  ]
}