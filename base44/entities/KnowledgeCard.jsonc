{
  "name": "KnowledgeCard",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "概念の名前"
    },
    "summary": {
      "type": "string",
      "description": "自分の言葉に近づけた要約"
    },
    "key_concepts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "カード同士を自動でつなぐ共通概念"
    },
    "open_question": {
      "type": "string",
      "description": "次に考えたい小さな問い"
    },
    "domain": {
      "type": "string",
      "description": "分野名"
    },
    "stack_id": {
      "type": "string"
    },
    "source_conversation_id": {
      "type": "string",
      "description": "出典となった対話"
    },
    "related_card_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "understanding": {
      "type": "number",
      "default": 0,
      "description": "0=これから / 1=わからないところがある / 2=だいたいわかる / 3=人に説明できる"
    },
    "visit_count": {
      "type": "number",
      "default": 0
    },
    "last_visited_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "summary"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
