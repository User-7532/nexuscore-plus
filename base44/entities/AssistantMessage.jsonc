{
  "name": "AssistantMessage",
  "properties": {
    "cards_checked": {
      "default": false,
      "description": "ここまでの会話を知識カードにしたときの印",
      "type": "boolean"
    },
    "content": {
      "description": "発言内容",
      "type": "string"
    },
    "page": {
      "description": "話しかけたときに開いていた画面",
      "type": "string"
    },
    "quote": {
      "description": "画面で選んで質問した文章（引用）",
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "添付した画像の保存先（本人だけが見られる保存先の場所）"
    },
    "role": {
      "description": "発言者",
      "enum": [
        "user",
        "assistant"
      ],
      "type": "string"
    }
  },
  "required": [
    "role",
    "content"
  ],
  "type": "object",
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}