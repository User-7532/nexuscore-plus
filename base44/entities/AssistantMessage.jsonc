{
  "name": "AssistantMessage",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant"
      ],
      "description": "発言者"
    },
    "content": {
      "type": "string",
      "description": "発言内容"
    },
    "page": {
      "type": "string",
      "description": "話しかけたときに開いていた画面"
    },
    "cards_checked": {
      "type": "boolean",
      "default": false,
      "description": "ここまでの会話を知識カードにしたときの印"
    }
  },
  "required": [
    "role",
    "content"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}