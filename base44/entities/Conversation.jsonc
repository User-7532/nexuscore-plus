{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "対話の見出し（最初の発話から自動でつく）"
    },
    "mode": {
      "type": "string",
      "enum": [
        "learn",
        "coach",
        "review"
      ],
      "default": "learn",
      "description": "learn=学びの対話 / coach=実装の伴走 / review=コードレビュー"
    },
    "stack_id": {
      "type": "string",
      "description": "土台にしている知識スタック"
    },
    "stack_name": {
      "type": "string"
    },
    "project_id": {
      "type": "string",
      "description": "実装の伴走のときの対象プロジェクト"
    },
    "summary": {
      "type": "string"
    },
    "message_count": {
      "type": "number",
      "default": 0
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    },
    "cards_generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
