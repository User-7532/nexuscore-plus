{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u5bfe\u8a71\u306e\u898b\u51fa\u3057\uff08\u6700\u521d\u306e\u767a\u8a71\u304b\u3089\u81ea\u52d5\u3067\u3064\u304f\uff09"
    },
    "mode": {
      "type": "string",
      "enum": [
        "learn",
        "coach",
        "review"
      ],
      "default": "learn",
      "description": "learn=\u5b66\u3073\u306e\u5bfe\u8a71 / coach=\u5b9f\u88c5\u306e\u4f34\u8d70 / review=\u30b3\u30fc\u30c9\u30ec\u30d3\u30e5\u30fc"
    },
    "stack_id": {
      "type": "string",
      "description": "\u571f\u53f0\u306b\u3057\u3066\u3044\u308b\u77e5\u8b58\u30b9\u30bf\u30c3\u30af"
    },
    "stack_name": {
      "type": "string"
    },
    "project_id": {
      "type": "string",
      "description": "\u5b9f\u88c5\u306e\u4f34\u8d70\u306e\u3068\u304d\u306e\u5bfe\u8c61\u30d7\u30ed\u30b8\u30a7\u30af\u30c8"
    },
    "summary": {
      "type": "string"
    },
    "message_count": {
      "type": "number",
      "default": 0
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    },
    "cards_generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title"
  ]
}