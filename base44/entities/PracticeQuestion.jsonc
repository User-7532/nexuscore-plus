    },
    "refined": {
      "default": false,
      "description": "\u8a18\u8ff0\u554f\u984c\u306e\u805e\u304d\u65b9\u3092\u898b\u76f4\u3057\u305f\u304b\uff08\u7b54\u3048\u306e\u7bc4\u56f2\u304c\u5b9a\u307e\u308b\u3088\u3046\u306b\u89b3\u70b9\u30fb\u6570\u3092\u8db3\u3057\u305f\u304b\u3069\u3046\u304b\uff09",
