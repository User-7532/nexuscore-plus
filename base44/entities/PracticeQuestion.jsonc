{
  "name": "PracticeQuestion",
  "type": "object",
  "properties": {
    "card_id": {
      "type": "string",
      "description": "もとになった知識カード"
    },
    "domain": {
      "type": "string",
      "description": "分野名（カードから引き継ぐ）"
    },
    "kind": {
      "type": "string",
      "enum": [
        "cloze",
        "written"
      ],
      "default": "cloze",
      "description": "cloze=穴埋め / written=記述"
    },
    "text": {
      "type": "string",
      "description": "穴埋めの文章（空所は ___）または記述の問い"
    },
    "answer": {
      "type": "string",
      "description": "空所に入る語句（記述では要点）"
    },
    "model_answer": {
      "type": "string",
      "description": "記述の模範解答"
    },
    "explanation": {
      "type": "string"
    },
    "field": {
      "type": "string"
    },
    "subfield": {
      "type": "string"
    },
    "assessment": {
      "type": "string",
      "enum": [
        "exact",
        "rubric"
      ],
      "default": "exact",
      "description": "exact=正誤で判定 / rubric=押さえるべき観点で判定"
    },
    "rubric": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "観点方式で判定するときの観点"
    }
  },
  "required": [
    "card_id",
    "text",
    "answer"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
