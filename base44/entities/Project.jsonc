{
  "name": "Project",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "one_liner": {
      "type": "string",
      "description": "ひとことで言うと何を作るか"
    },
    "motivation": {
      "type": "string",
      "description": "なぜ作るのか。誰のどんな痛みに向かうか"
    },
    "stage": {
      "type": "string",
      "enum": [
        "family",
        "mind",
        "community",
        "society"
      ],
      "default": "family",
      "description": "family=家族・身近な課題 / mind=自分の精神のハック / community=身近な共同体 / society=社会実装"
    },
    "status": {
      "type": "string",
      "enum": [
        "idea",
        "building",
        "polishing",
        "shipped"
      ],
      "default": "idea"
    },
    "next_step": {
      "type": "string",
      "description": "次にやる一番小さな一歩"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "done": {
            "type": "boolean"
          }
        }
      },
      "description": "実装のステップ"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        }
      },
      "description": "プロジェクトのコード"
    },
    "related_card_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_review": {
      "type": "string"
    },
    "last_review_at": {
      "type": "string",
      "format": "date-time"
    },
    "github_url": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
